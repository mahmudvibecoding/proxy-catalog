FROM python:3.14.5-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates zstd \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home worker
ENV PYTHONUNBUFFERED=1 GIT_TERMINAL_PROMPT=0
WORKDIR /work
USER worker
CMD ["sleep", "infinity"]

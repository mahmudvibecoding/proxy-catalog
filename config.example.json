{
  "repository": "mahmudvibecoding/proxy-catalog",
  "timezone": "Asia/Tashkent",
  "model": "gpt-6.1-sol",
  "reasoning_effort": "max",
  "codex": "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex",
  "database": {"dbname": "proxy", "user": "mahmud", "host": "localhost", "port": 5432},
  "postgres_service": {"data_directory": "/absolute/path/to/existing/postgres/cluster"},
  "concurrency": 24,
  "per_host": 2,
  "github_concurrency": 8,
  "retries": 2,
  "chunk_bytes": 536870912,
  "retain_daily": 7,
  "retain_weekly": 4,
  "continuous": {
    "enabled": true,
    "intake_seconds": 300,
    "publish_seconds": 3600,
    "retry_seconds": 300,
    "terminal_retry_seconds": 86400,
    "parse_workers": 4,
    "retain_hourly": 24,
    "local_snapshots": 2
  }
}

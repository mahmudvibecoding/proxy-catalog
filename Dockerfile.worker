FROM postgres:18.6-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv git curl ca-certificates zstd \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd --uid 10001 --create-home worker
ENV PATH="/opt/venv/bin:${PATH}" PYTHONUNBUFFERED=1 GIT_TERMINAL_PROMPT=0
WORKDIR /work
USER worker
ENTRYPOINT []
CMD ["python", "remote_worker.py", "collect"]
